# Copia este archivo como .env y rellena los valores.
# El .env real NUNCA se sube al repositorio.

# Obligatorio. Minimo 32 caracteres. Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Opcionales
PORT=3001
FRONTEND_URL=http://localhost:5173
KIOSK_DEFAULT_SEDE=Ninja Park Candelaria

# Creacion del primer usuario master. Dejar en false salvo la primera vez.
SEED_DEFAULT_USERS=false
MASTER_USERNAME=
MASTER_PASSWORD=
MASTER_NOMBRE=Master
