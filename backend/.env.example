# Copia este archivo como .env y rellena los valores.
# El .env real NUNCA se sube al repositorio.

# ─── Base de Datos ───
# Vacío (o la variable no existe) = usa SQLite local (desarrollo)
# URL de PostgreSQL = usa Postgres (producción en Render/Railway)
DATABASE_URL=

# ─── JWT (obligatorio, mínimo 32 caracteres) ───
JWT_SECRET=0b87c75a10397330258063f9d7f67db1de56b6f7a4156369df872aa5e0c2c583

# ─── CORS - URL exacta del frontend ───
FRONTEND_URL=http://localhost:5173

# ─── Puerto del servidor ───
PORT=3001

# ─── Creación del primer usuario master ───
# Dejar SEED_DEFAULT_USERS=false después del primer deploy
SEED_DEFAULT_USERS=true
MASTER_USERNAME=admin
MASTER_PASSWORD=CambiaEstaContraseñaYA!
MASTER_NOMBRE=Master Admin

# ─── Sede por defecto del kiosko ───
KIOSK_DEFAULT_SEDE=Ninja Park Candelaria
